{
    "mcpServers": {
      "filesystem": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/Users/hdos/Desktop",
          "/Users/hdos/Downloads"
        ]
      },
      "convert-currency": {
          "command": "/Users/hdos/Desktop/Modern Security/LLM-Security/myenv/bin/python3",
          "args": ["/Users/hdos/Desktop/Modern Security/LLM-Security/LLM-Basics/MCP/MCP-Server/mcp-local-server.py"]
      },
      "github": {
        "command": "docker",
        "args": [
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server"
        ],
        "env": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "replace-with-your-github-token"
        }
      },
      "convert-currency-remote": {
        "command": "npx",
        "args": ["mcp-remote", "http://localhost:8050/sse"]
      }
    }
  }
